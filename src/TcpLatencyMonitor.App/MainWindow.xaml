<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TcpLatencyMonitor.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:TcpLatencyMonitor.App.Controls">
 <Grid x:Name="RootGrid" Background="{ThemeResource MonitorApplicationBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Grid Padding="24,0" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Spacing="3">
    <TextBlock Text="IP 质量监控" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="多目标持续采样 · 路由历史 · 时段对比" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button Content="统一设置" Click="UnifiedSettings_Click"/>
    <Button x:Name="ExportButton" Content="导出诊断包" Click="Export_Click" IsEnabled="False"/>
    <Button Content="数据目录" Click="OpenData_Click"/>
    <Button Content="退出" Click="Exit_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Padding="20" ColumnSpacing="20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="TargetNavigation" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12">
     <StackPanel Spacing="8">
      <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="AllTargetsButton" Content="全部目标" HorizontalAlignment="Stretch" Click="AllTargets_Click"/><Button Grid.Column="1" Content="＋ 添加" Click="AddTarget_Click"/></Grid>
      <TextBox x:Name="TargetSearchBox" PlaceholderText="搜索名称或 IP" TextChanged="TargetSearch_Changed"/>
      <ListView x:Name="TargetList" MaxHeight="320" SelectionMode="Single" SelectionChanged="TargetList_Changed" HorizontalContentAlignment="Stretch"/>
      <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="StartAllButton" Content="全部开始" Click="StartAll_Click" HorizontalAlignment="Stretch"/><Button x:Name="StopAllButton" Grid.Column="1" Content="全部暂停" Click="StopAll_Click" HorizontalAlignment="Stretch"/></Grid>
      <Button Content="恢复已移除目标" Click="RestoreTarget_Click" FontSize="11" HorizontalAlignment="Stretch"/>
     </StackPanel>
     <Expander x:Name="TargetEditor" Header="目标设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
     <Border Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
      <StackPanel Spacing="10">
       <TextBox x:Name="NameBox" Header="名称（可选）" PlaceholderText="例如 洛杉矶 A" MaxLength="60"/>
       <TextBox x:Name="AddressBox" Header="目标 IP" PlaceholderText="填写 IPv4 或 IPv6 地址" MaxLength="80"/>
       <ComboBox x:Name="ProtocolBox" Header="检测方式" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Protocol_Changed">
        <ComboBoxItem Content="ICMP · 只需 IP"/><ComboBoxItem Content="TCP · 指定端口"/><ComboBoxItem Content="ICMP + TCP · 分别统计"/>
       </ComboBox>
       <NumberBox x:Name="PortBox" Header="TCP 端口" Value="443" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"/>
       <Expander x:Name="AdvancedBox" Header="异常判断阈值" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="10">
         <NumberBox x:Name="FailuresBox" Header="连续失败确认次数" Value="3" Minimum="2" Maximum="20"/>
         <NumberBox x:Name="RecoveriesBox" Header="连续恢复确认次数" Value="3" Minimum="2" Maximum="20"/>
         <NumberBox x:Name="IncreaseBox" Header="延迟增幅（毫秒）" Value="50" Minimum="1" Maximum="10000"/>
         <NumberBox x:Name="FactorBox" Header="延迟相对倍数" Value="1.5" Minimum="1.1" Maximum="10" SmallChange="0.1"/>
         <NumberBox x:Name="SustainBox" Header="延迟持续时间（秒）" Value="30" Minimum="10" Maximum="600"/>
        </StackPanel>
       </Expander>
       <CheckBox x:Name="ResumeBox" Content="下次打开后自动监控" FontSize="12"/>
       <Button x:Name="HistoryButton" Content="保存设置" HorizontalAlignment="Stretch" Click="History_Click" IsEnabled="False"/>
       <Button x:Name="LegacyButton" Content="查看旧版 TCP 历史" Click="Legacy_Click" FontSize="12" Visibility="Collapsed"/>
       <Button x:Name="RemoveTargetButton" Content="移除目标（保留历史）" Click="RemoveTarget_Click" FontSize="11"/>
       <TextBlock x:Name="InputError" Foreground="#D64747" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"/>
      </StackPanel>
     </Border>
     </Expander>
     <Border Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
      <StackPanel Spacing="10">
       <TextBlock x:Name="RunState" Text="尚未开始" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock x:Name="TargetText" Text="填写目标后开始监控" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/>
       <TextBlock x:Name="SessionText" Text="本次运行 · 暂无采样" FontSize="12" TextWrapping="Wrap"/>
       <TextBlock x:Name="FailureText" Text="连续失败 · —" FontSize="12" TextWrapping="Wrap"/>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="StartButton" Content="开始监控" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Start_Click" IsEnabled="False"/>
        <Button x:Name="StopButton" Grid.Column="1" Content="停止" HorizontalAlignment="Stretch" Click="Stop_Click" IsEnabled="False"/>
       </Grid>
      </StackPanel>
     </Border>
     <StackPanel Padding="4,0" Spacing="8">
      <TextBlock Text="统计口径" FontWeight="SemiBold" FontSize="12"/>
      <TextBlock Text="ICMP 回应率和 TCP 建连成功率分别统计；无回应不直接判为离线。中间跳不回复不等于链路丢包。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
      <TextBlock Text="暂停、休眠和退出期间不补记失败。本地错误单独记录。关闭窗口后继续在托盘监控。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="DashboardScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="WorkspaceTitle" Text="全部目标" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <ComboBox x:Name="GlobalProtocolBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="GlobalProtocol_Changed"><ComboBoxItem Content="ICMP"/><ComboBoxItem Content="TCP"/></ComboBox>
      <ComboBox x:Name="PeriodBox" Grid.Column="2" SelectedIndex="0" SelectionChanged="Period_Changed"><ComboBoxItem Content="近 24 小时"/><ComboBoxItem Content="近 7 天"/></ComboBox>
     </Grid>
     <StackPanel x:Name="UnifiedSettingsPanel" Spacing="16" Visibility="Collapsed" MaxWidth="860" HorizontalAlignment="Stretch">
      <TextBlock Text="所有目标共用；新增目标自动沿用。保存后，运行中的目标按新参数继续采样，已暂停的目标保持暂停。" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12"/>
      <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
       <TextBlock Text="检测频率与路由" FontSize="16" FontWeight="SemiBold"/>
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <NumberBox x:Name="IntervalBox" Header="间隔（秒）" Value="5" Minimum="1" Maximum="3600"/>
        <NumberBox x:Name="TimeoutBox" Grid.Column="1" Header="超时（毫秒）" Value="3000" Minimum="100" Maximum="60000"/>
       </Grid>
       <CheckBox x:Name="RoutesBox" Content="定期路由与异常诊断" IsChecked="True" FontSize="12"/>
       <NumberBox x:Name="RouteMinutesBox" Header="路由间隔（分钟）" Value="10" Minimum="1" Maximum="1440"/>
       <Expander Header="路由探测参数" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10">
         <NumberBox x:Name="MaxHopsBox" Header="路由最大跳数" Value="32" Minimum="1" Maximum="64"/>
         <NumberBox x:Name="RouteTimeoutBox" Header="单次探测超时（毫秒）" Value="1500" Minimum="100" Maximum="5000"/>
         <NumberBox x:Name="RouteBudgetBox" Header="整轮路由上限（秒）" Value="60" Minimum="1" Maximum="180"/>
       </StackPanel></Expander>
       <TextBlock Text="路由初测每跳 3 次；无回应节点在整轮时间预算内补测至最多 10 次。" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12"/>
       <Button x:Name="SaveGlobalButton" Content="保存并应用所有目标" Click="SaveGlobal_Click" Style="{StaticResource AccentButtonStyle}"/>
       <TextBlock x:Name="GlobalSettingsStatus" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel></Border>
      <Border Style="{StaticResource SectionCard}"><StackPanel Spacing="12">
       <TextBlock Text="节点定位与线路注释" FontSize="16" FontWeight="SemiBold"/>
      <StackPanel Spacing="5">
       <CheckBox x:Name="MetadataBox" Content="在线节点注释（运营商 / ASN / 地区）" Click="Metadata_Click" FontSize="12"/>
       <CheckBox x:Name="BackgroundMetadataBox" Content="自动注释新路由（托盘隐藏时继续查询）" Click="Metadata_Click" FontSize="12" IsEnabled="False"/>
       <TextBlock x:Name="AnnotationQueryNotice" Text="在线定位使用所选数据源，数据库默认缓存 24 小时；仅最近 24 小时路由中出现的公网节点自动刷新。私网不提交。" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
      </StackPanel>
       <Button Content="定位数据源 / NextTrace 令牌" Click="GeoSettings_Click"/>
       <TextBlock Text="注释开关立即生效；定位数据源、令牌和缓存周期在弹窗中保存。" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="AllTargetsPanel" Spacing="12" Visibility="Collapsed">
      <Grid><TextBlock x:Name="AllTargetsInfo" Text="添加目标后开始监测" FontSize="12" VerticalAlignment="Center"/><Button x:Name="CompareButton" Content="对比所选（0/4）" Click="Compare_Click" HorizontalAlignment="Right"/></Grid>
      <TextBlock Text="勾选最多 4 个目标进行对比；点击目标名称查看图表和完整简要路由。" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><Grid x:Name="AllTargetsGrid" MinWidth="700" ColumnSpacing="10"/></ScrollViewer>
      <TextBlock x:Name="OverviewAsOf" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel x:Name="ComparePanel" Spacing="12" Visibility="Collapsed">
      <TextBlock x:Name="CompareInfo" FontSize="12" TextWrapping="Wrap"/>
      <StackPanel x:Name="CompareLegend" Spacing="5"/>
      <controls:MultiLatencyChart x:Name="CompareChart" Height="230"/>
      <TextBlock x:Name="CompareRange" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
      <Grid><TextBlock Text="小时分布 · 全部目标共用颜色范围" FontSize="13" VerticalAlignment="Center"/><ComboBox x:Name="CompareMetricBox" SelectedIndex="0" HorizontalAlignment="Right" SelectionChanged="CompareMetric_Changed"><ComboBoxItem Content="平均延迟"/><ComboBoxItem Content="失败比例"/></ComboBox></Grid>
      <StackPanel x:Name="CompareHours" Spacing="16"/>
      <TextBlock x:Name="CompareHeatLegend" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/>
     </StackPanel>
     <StackPanel x:Name="TargetDetailPanel" Spacing="12">
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="PageBox" SelectedIndex="0" SelectionChanged="Page_Changed" HorizontalAlignment="Left"><ComboBoxItem Content="概览"/><ComboBoxItem Content="路由历史"/><ComboBoxItem Content="异常与事件"/></ComboBox>
      <ComboBox x:Name="ViewProtocolBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="ViewProtocol_Changed" Visibility="Collapsed"><ComboBoxItem Content="ICMP 统计"/><ComboBoxItem Content="TCP 统计"/></ComboBox>
     </Grid>
     <ComboBox x:Name="RevisionBox" Header="历史配置" Visibility="Collapsed" SelectionChanged="Revision_Changed" HorizontalAlignment="Stretch"/>
     <TextBlock x:Name="ContextText" Text="系统选路信息将在开始监控后显示" TextWrapping="Wrap" Style="{StaticResource MetricLabel}"/>
     <StackPanel x:Name="OverviewPanel" Spacing="12">
     <Border Style="{StaticResource SectionCard}" Padding="12">
      <StackPanel Spacing="4">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="OverviewRouteTitle" Text="最新路由 · 等待首次检查" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
         <CheckBox x:Name="OverviewAllNodes" Content="显示全部节点" FontSize="11" MinHeight="24" Click="OverviewNodes_Click" ToolTipService.ToolTip="勾选后同时显示私网等非公网节点和未回应行；未勾选时显示全部符合筛选条件的行。"/>
         <Button Content="路由详情" Click="OverviewRoute_Click" FontSize="11" Padding="10,4"/>
        </StackPanel>
       </Grid>
       <TextBlock x:Name="OverviewRouteSummary" Text="启动监控后显示简要路由。" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
       <Grid x:Name="OverviewRouteGrid" Margin="0,3,0,0"/>
       <TextBlock x:Name="OverviewTableInfo" Text="暂无路由记录" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/>
      </StackPanel>
     </Border>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource MetricCard}" Padding="12"><StackPanel Spacing="4"><TextBlock Text="最近一次探测" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LatestValue" Text="—" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="LatestHint" Text="等待采样" FontSize="11"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource MetricCard}" Padding="12"><StackPanel Spacing="4"><TextBlock x:Name="AvailabilityLabel" Text="近 5 分钟回应率" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="AvailabilityValue" Text="—" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="AvailabilityHint" Text="暂无采样" FontSize="11"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="12"><StackPanel Spacing="4"><TextBlock Text="近 1 小时 P95" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="P95Value" Text="—" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="成功探测延迟 · 毫秒" FontSize="11"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource SectionCard}">
      <StackPanel Spacing="10">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="3"><TextBlock Text="时段表现" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="TimelineInfo" Text="折线与小时格共用时间范围" FontSize="11" TextWrapping="Wrap"/></StackPanel>
        
       </Grid>
       <controls:LatencyChart x:Name="Chart" Height="130"/>
       <Grid><TextBlock x:Name="ChartFrom" Style="{StaticResource MetricLabel}"/><TextBlock Text="青线：均值　淡线：范围　红点：失败" HorizontalAlignment="Center" FontSize="11"/><TextBlock x:Name="ChartUntil" HorizontalAlignment="Right" Style="{StaticResource MetricLabel}"/></Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="小时分布 · 本地时间" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <ComboBox x:Name="HeatMetricBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="HeatMetric_Changed" FontSize="11"><ComboBoxItem Content="平均延迟"/><ComboBoxItem Content="失败比例"/></ComboBox>
       </Grid>
       <Grid x:Name="HourGrid" ColumnSpacing="3" RowSpacing="3"/>
       <TextBlock x:Name="HeatLegend" Text="灰：未采样 · 空位：范围外 · 点击小时格查看详情" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/>
       <TextBlock x:Name="HourDetail" Text="点击一个小时，可在折线图中定位对应时段。" FontSize="11" TextWrapping="Wrap"/>
       <Expander Header="更多统计（P50 / 极值 / 延迟波动）" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock x:Name="VariationText" Text="延迟波动与采样覆盖将在采集后显示" TextWrapping="Wrap" Style="{StaticResource MetricLabel}"/></Expander>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SectionCard}">
      <StackPanel Spacing="10">
       <TextBlock Text="历史统计" FontSize="15" FontWeight="SemiBold"/>
       <Grid x:Name="SummaryGrid" RowSpacing="12"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SectionCard}">
      <StackPanel Spacing="10">
       <Grid><TextBlock Text="最近 20 次采样" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="最新在上 · 所有记录保留 31 天" HorizontalAlignment="Right" Style="{StaticResource MetricLabel}"/></Grid>
       <StackPanel x:Name="RecentPanel" Spacing="7"><TextBlock Text="开始监控后，记录将显示在这里。" Style="{StaticResource MetricLabel}"/></StackPanel>
      </StackPanel>
     </Border>
     </StackPanel>
     <StackPanel x:Name="RoutePanel" Spacing="14" Visibility="Collapsed">
      <Grid><TextBlock Text="本地 → 目标 · ICMP 路由" FontSize="16" FontWeight="SemiBold"/><Button x:Name="RouteButton" Content="立即检查" Click="Route_Click" HorizontalAlignment="Right" IsEnabled="False"/></Grid>
      <TextBlock x:Name="RouteStatus" Text="开始监控后，自动记录第一份路由快照。" TextWrapping="Wrap" Style="{StaticResource MetricLabel}"/>
      <ComboBox x:Name="RouteSelector" HorizontalAlignment="Stretch" PlaceholderText="选择历史路由（最近 200 次）" SelectionChanged="RouteSelection_Changed"/>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="补全 / 更新注释" Click="Reannotate_Click" FontSize="12"/><CheckBox x:Name="OriginalAnnotationBox" Content="查看最早保存的注释" Click="OriginalAnnotation_Click" FontSize="12"/></StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="统一设置" Click="UnifiedSettings_Click" FontSize="12"/>
        <Button Content="校准节点" Click="GeoNodeSelect_Click" FontSize="12"/>
       </StackPanel>
      <TextBlock x:Name="RouteDetails" TextWrapping="Wrap" FontSize="12"/>
      <TextBlock x:Name="RouteAnnotationSummary" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"/>
      <TextBlock x:Name="RouteAnnotationEvidence" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
      <StackPanel x:Name="RouteRows" Spacing="9"/>
      <TextBlock Text="初测每跳 3 次；无回应节点在时间预算内补测，合计最多 10 次，取得回应即停止补测。未回应不等于实际业务丢包，补测发现的节点单独标明。" TextWrapping="Wrap" Style="{StaticResource MetricLabel}"/>
     </StackPanel>
     <StackPanel x:Name="EventsPanel" Spacing="14" Visibility="Collapsed">
      <TextBlock Text="异常与事件" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="按诊断参数确认异常与恢复。点击路由相关事件查看当时的快照。完整记录可导出。" TextWrapping="Wrap" Style="{StaticResource MetricLabel}"/>
      <StackPanel x:Name="EventRows" Spacing="10"/>
     </StackPanel>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Padding="20,0" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
   <TextBlock x:Name="StatusText" Text="正在初始化…" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>
