# Default is loopback-only. For direct LAN access, set the NAS LAN IPv4 address.
# 0.0.0.0 publishes on all host IPv4 interfaces: use only with appropriate firewall/TLS.
IPQUALITY_BIND_ADDRESS=127.0.0.1
IPQUALITY_HTTP_PORT=8088
IPQUALITY_SITE_NAME=家庭 NAS · Docker bridge
IPQUALITY_TIME_ZONE=Asia/Shanghai
# Optional first-bootstrap username. Absent defaults to admin; explicit empty is invalid.
# Case-sensitive ASCII only: [A-Za-z0-9_.-]{1,64}. Existing accounts ignore this value.
# IPQUALITY_ADMIN_USERNAME=nas-admin
# This Compose uses IPQUALITY_ADMIN_PASSWORD_FILE. Do NOT add IPQUALITY_ADMIN_PASSWORD
# to its environment, even empty: the two password sources are mutually exclusive by presence.
# Set true when the browser always uses HTTPS. Do not use true for HTTP-only testing.
IPQUALITY_SECURE_COOKIES=false
# When using a TLS reverse proxy, list its actual source IP(s), comma-separated.
# The proxy must overwrite X-Forwarded-Proto; unknown senders are not trusted.
IPQUALITY_TRUSTED_PROXIES=
